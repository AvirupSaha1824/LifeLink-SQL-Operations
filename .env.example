# MySQL 8 / TiDB connection. Keep this server-side and never commit a real value.
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE?ssl={"rejectUnauthorized":true}

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters

# Existing Manus OAuth variables remain optional for the original demo flow.
OAUTH_SERVER_URL=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=
